  - "\u3060\u308C\u304B\u305F\u3059\u3051\u3066\uFF5E\u2026\u2026"
  - "\u304A\u5144\u3061\u3083\u3093\uFF01\uFF1F\\n\u306A\u3093\u3067\u3053\u3053\u306B\u3044\u308B\u306E\uFF01\uFF1F"
